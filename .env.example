# Copie para .env (o .env e ignorado pelo git). Nunca commite credenciais.

# Contas do Coupa. Usuario e senha podem ficar so no banco (gerenciador de credenciais do painel);
# aqui ficam o nome da filial e, durante a transicao, a senha antiga como reserva.
# Conta 1 do Coupa (a que ja existe)
VALE_USER=
VALE_PASS=
VALE_CONTA_NOME=Seven Matriz

# Conta 2 do Coupa (segunda filial)
VALE_USER_2=
VALE_PASS_2=
VALE_CONTA_NOME_2=Seven Filial 2

# Opcional: sem a chave, a coluna Marca sai como "Marca nao encontrada"
GEMINI_API_KEY=

# Obrigatorios so fora do modo simulacao
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=planilhas

# Teste local: 1 = nunca grava no banco nem no Storage, so salva a planilha em saida_teste
ROBO_SIMULAR=1

# Gerenciador de credenciais (senhas do Coupa no banco, cifradas)
# Chave de cifra. Gerar uma vez: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A MESMA chave em todo servidor que usa o mesmo banco (local e VPS), senao as senhas ficam ilegiveis.
CREDENCIAIS_CHAVE=
# Chave SECRETA do Supabase (sb_secret_... ou service_role). So no servidor, nunca no front.
SUPABASE_SECRET_KEY=
# Quem pode alterar credenciais: papel 'admin' na tabela public.perfis do Supabase (nao fica mais no .env)
