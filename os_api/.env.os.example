# Copie para .env.os e preencha. Nunca coloque SUPABASE_SECRET_KEY aqui: o os_api se recusa a subir com ela.
OS_DATABASE_URL=postgresql://os_app.hwiyzclxtvggdhrxbsmc:SENHA_DO_OS_APP@aws-1-us-east-2.pooler.supabase.com:5432/postgres
OS_SCHEMA=os_homolog
SUPABASE_URL=https://hwiyzclxtvggdhrxbsmc.supabase.co
SUPABASE_KEY=CHAVE_PUBLISHABLE
OS_CORS_ORIGINS=http://localhost:3000
# Pagina do front onde o convidado cria a senha (precisa estar em Auth > URL Configuration > Redirect URLs)
OS_CONVITE_REDIRECT=http://localhost:3000/definir-senha

# Assistente com IA via n8n (opcional; sem isso o assistente usa regras). Ver docs/n8n/README.md
OS_N8N_ASSISTENTE_URL=
# OS_N8N_TOKEN= (opcional; so se o webhook exigir cabecalho X-Seven-Token)
